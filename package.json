{
  "name": "claudelingo",
  "version": "0.3.0",
  "description": "Learn a language in the dead time while Claude is working. A spaced-repetition quiz in the band above your Claude Code prompt, answered with a digit.",
  "type": "module",
  "license": "MIT",
  "author": "AI Experts LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AI-Experts-LLC/claudelingo.git"
  },
  "keywords": [
    "claude-code",
    "mod",
    "function-hooks",
    "language-learning",
    "spaced-repetition",
    "vocabulary"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "claude plugin validate .",
    "test:kit": "claude plugin test .",
    "check": "npm run typecheck && npm run validate && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
